{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PS-AMS default capability: SQL and fs access for offline academy operations. File/folder dialogs run on the Rust side (picks.rs) and extend the fs scope per pick — the webview can never originate arbitrary paths (PS-014).",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" }
      ]
    },
    "shell:allow-open"
  ]
}
