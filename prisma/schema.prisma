// ============================================================
// PS-AMS :: Pattern Sports Academy Management System
// SQLite schema (Prisma) — mirrors database/schema.sql for Tauri
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id               String   @id @default(cuid())
  admissionNo      String   @unique
  registrationDate DateTime @default(now())

  // Bio-data
  fullName         String
  dateOfBirth      DateTime
  parentName       String
  mobile           String
  emergencyContact String?
  address          String?

  // Academic
  schoolName String?
  classGrade String?
  division   String?
  bloodGroup String?

  // Athletic & biometric parameters
  heightCm        Float?
  weightKg        Float?
  standingReachCm Float?
  spikeReachCm    Float?
  jumpReachCm     Float?
  primarySport    String  @default("Volleyball")
  playingPosition String?
  ageCategory     String // Mini | Sub-Junior | Junior | Youth | Senior
  trainingBatch   String? // Morning | Evening
  monthlyFee      Float   @default(0)

  // Media — sanitized RELATIVE paths only (files live on disk, never BLOBs)
  photoPath      String?
  birthCertPath  String?
  idCardPath     String?

  status      String     @default("Active") // Active | Inactive | Alumni
  achievements Achievement[]
  payments    FeePayment[]
  attendance  Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([mobile])
  @@index([ageCategory])
  @@index([status])
  @@index([schoolName])
}

model Achievement {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tournamentName String
  eventDate      DateTime?
  level          String // School | District | State | National
  medal          String // Gold | Silver | Bronze | Participation | None
  notes          String?
  certificatePath String? // relative media path
  createdAt      DateTime  @default(now())

  @@index([studentId])
  @@index([level])
}

model FeePayment {
  id          String   @id @default(cuid())
  receiptNo   String   @unique
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentDate DateTime @default(now())
  months      String // JSON array of billing periods "YYYY-MM" (multi-month settle)
  amount      Float
  paymentMode String // Cash | UPI / GPay | Bank Transfer
  notes       String?
  collectedBy String?
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([paymentDate])
  @@index([receiptNo])
}

model CommitteeMember {
  id              String  @id @default(cuid())
  fullName        String
  role            String // President | General Secretary | Treasurer | Executive Member
  phone           String
  responsibilities String?
  photoPath       String?
  displayOrder    Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([role])
  @@index([displayOrder])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD" local session date
  batch     String // training batch label at the time of marking
  status    String // Present | Absent
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([date])
  @@index([batch])
}

model Setting {
  key   String @id
  value String
}
