# PS-AMS — copy this file to .env and adjust if needed.
# SQLite database file; relative paths are resolved against prisma/schema.prisma,
# so this points at <project root>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# ---- Optional web API token (see README → Security) ----
# The web API is loopback-only by default (no auth). Set a token when the
# server must be reachable from other machines:
#   PSAMS_API_TOKEN            — server-side verification only
#   NEXT_PUBLIC_PSAMS_API_TOKEN — additionally inlined into the web client so
#     the UI sends it automatically (x-psams-token header / ?token= for media).
# Set BOTH to keep the bundled client working with auth enabled.
# PSAMS_API_TOKEN=""
# NEXT_PUBLIC_PSAMS_API_TOKEN=""
