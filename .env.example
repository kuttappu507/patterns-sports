# PS-AMS — copy this file to .env and adjust if needed.
# SQLite database file; relative paths are resolved against prisma/schema.prisma,
# so this points at <project root>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# ---- Optional web API token (see README → Security) ----
# The web API binds 127.0.0.1 (loopback) by default and, with a token set,
# requires it on every /api/* request (x-psams-token header, or the HttpOnly
# psams_token cookie the server issues on page loads — ?token= URLs are not
# accepted). Set a token when the server must be reachable from other machines:
#   PSAMS_API_TOKEN             — server-side verification only (recommended)
#   NEXT_PUBLIC_PSAMS_API_TOKEN — additionally inlined into the web client so
#     the UI fetches send it automatically (x-psams-token header).
# PSAMS_API_TOKEN=""
# NEXT_PUBLIC_PSAMS_API_TOKEN=""

# ---- Server bind (scripts/start-server.mjs, `npm start`) ----
# Default bind is 127.0.0.1. A non-loopback bind REQUIRES one of the tokens
# above. PSAMS_BIND overrides everything (explicit); HOSTNAME is honoured
# only when it is a valid bind address and not the shell's machine name.
# PSAMS_BIND="127.0.0.1"
# Explicitly accept an unauthenticated LAN bind (NOT recommended):
# PSAMS_API_OPEN="1"
